 	@symbol{dens,
		name={\ensuremath{ \rho }},	%
		description={mass density},
		unit= {\si{\kg\m\tothe{-\glspt{dim}} } },
		category= {scalar variable},
	}

	@symbol{dim, %
		name={\ensuremath{ D }}, %
		description={physical space dimension}, %
		unit= {\ensuremath{ \varnothing }}, %
		category= {scalar variable},
	} 
	
	@symbol{BoltzDist, %
		name={\ensuremath{ f }}, %
		description={density distribution function over velocity space}, %
		unit= {\si{ \kg\m\tothe{-\glspt{dim}-1} \s\tothe{1} } }, %
		category= {distribution},
	}

	@symbol{BoltzDist_parti, %
		name={\ensuremath{ \check{\glspt{BoltzDist}} }}, %
		description={particles distribution function over velocity space}, %
		unit= {\si{ \m\tothe{-\glspt{dim}-1} \s\tothe{1} } }, %
		category= {distribution},
	}

	@symbol{mass_parti, %
		name={\ensuremath{ m_p }}, %
		description={mass of particles}, %
		unit= {\si{ \kg } }, %
		category= {scalar variable},
	}
	
	@symbol{parti_spe, %
		name={\ensuremath{ \boldsymbol{\xi} }}, %
		description={microscopic velocity of particles}, %
		unit= {\si{\m\per\s}}, %
		category= {vector variable},
	}
	
	@symbol{spe, %
		name={\ensuremath{ \boldsymbol{v} }}, %
		description={macroscopic speed field}, %
		unit= {\si{\m\per\s}}, %
		category= {vector variable},
	}
	
	@symbol{disp, %
		name={\ensuremath{ \boldsymbol{u} }}, %
		description={displacement field}, %
		unit= {\si{\m}}, %
		category= {vector variable},
	}

	@symbol{stre, %
		name={\ensuremath{ \sigma }}, %
		description={\famName{Cauchy} stress tensor}, %
		unit= {\si{\kg\m\per\s\squared }}, %
		category= {matrix variable},
	}
	
	@symbol{stra, %
		name={\ensuremath{ \varepsilon }}, %
		description={linearised strain tensor}, %
		unit= {\ensuremath{ \varnothing }}, %
		category= {matrix variable},
	}

	@symbol{lgc, %
		name={\ensuremath{ B }}, %
		description={left \famName{Green}-\famName{Cauchy} strain tensor}, %
		unit= {\si{\kg\m\per\s\squared }}, %
		category= {matrix variable},
	}

	@symbol{elasTensor, %
		name={\ensuremath{ C }}, %
		description={fourth-order stiffness tensor}, %
		unit= {\si{\kg\m\per\s\squared }}, %
		category= {tensor variable},
	}
	
	@symbol{hentro, %
		name={\ensuremath{ H }}, %
		description={\famName{Gibbs}-\famName{Boltzmann} entropy}, %
		unit= {\si{\J\per\K}}, %
		category= {scalar variable},
	}
	
	@symbol{entro, %
		name={\ensuremath{ s }}, %
		description={entropy}, %
		unit= {\si{\J\per\K}}, %
		category= {scalar variable},
	}

