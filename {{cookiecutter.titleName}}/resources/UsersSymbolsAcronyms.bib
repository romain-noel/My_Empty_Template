		unit= {\si{\watt\m\tothe{-\glspt{dim}+1} }}, %
		category= {vector variable},
	}
	
	@symbol{ray, %
		name={\ensuremath{ r }}, %
		description={radiation}, %
		unit= {\si{\watt\m\tothe{-\glspt{dim}} }}, %
		category= {scalar variable},
	}

	@symbol{forcg, %
		name={\ensuremath{ \boldsymbol{g} }}, %
